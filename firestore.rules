rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isSuperAdmin() {
      // FIX: was 'superAdmin' — App.jsx uses 'super_admin'
      return isSignedIn() && getRole() == 'super_admin';
    }

    function isAsha() {
      return isSignedIn() && getRole() == 'asha';
    }

    function isStaff() {
      return isAdmin() || isSuperAdmin() || isAsha();
    }

    // ── Users collection ──────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin() || isSuperAdmin();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Patients collection ───────────────────────────────────────────────────

    match /patients/{patientId} {
      // Staff (admin, super_admin, asha) can read all patients
      // Patients can only read their own record
      allow read:   if isStaff() || isOwner(patientId);
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin() || isSuperAdmin();

      // ── Visits sub-collection ─────────────────────────────────────────────
      match /visits/{visitId} {
        allow read:   if isStaff() || isOwner(patientId);
        allow create: if isStaff();
        allow update: if isStaff();
        allow delete: if isAdmin() || isSuperAdmin();
      }
    }

    // ── AI Response Cache collection ──────────────────────────────────────────
    // Frontend reads to show "Recently Asked" questions (onSnapshot, limit 5).
    // Writes are done exclusively by the backend via Admin SDK — deny here.

    match /cached_responses/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── Government Schemes collection ─────────────────────────────────────────

    match /govt_schemes/{schemeId} {
      // Everyone signed in can read schemes
      allow read:   if isSignedIn();
      // Only admin / super_admin can manage schemes
      allow create: if isAdmin() || isSuperAdmin();
      allow update: if isAdmin() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

  }
}
